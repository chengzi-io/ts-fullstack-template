{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  // Only negations: core already provides "**" (re-adding it fails noBiomeFirstException).
  "files": {
    "includes": [
      // shadcn (CLI / monorepo shared package)
      "!packages/ui/src/components",
      "!packages/ui/src/lib",
      "!packages/ui/src/hooks",
      "!**/src/components/ui",
      "!**/components/theme-provider.tsx",
      // codegen & generated artifacts
      "!**/src/gen",
      "!**/src/generated",
      "!**/src/__generated__",
      "!**/*.gen.ts",
      "!**/*.gen.tsx",
      "!**/*.generated.ts",
      "!**/*.generated.tsx",
      "!**/routeTree.gen.ts",
      "!**/graphql-env.d.ts",
      "!**/graphql-env.ts",
      "!**/prisma/generated",
      "!**/drizzle/meta"
    ]
  },
  "overrides": [
    // Biome replaces (not merges) rule options across overrides, so the more
    // specific overrides below repeat the restrictions of the broader ones.
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@workspace/api": {
                    "allowImportNames": [
                      "AppRouter",
                      "RouterInputs",
                      "RouterOutputs"
                    ],
                    "message": "apps/web may only type-import AppRouter / RouterInputs / RouterOutputs from @workspace/api."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/api/**",
                      "@workspace/*/router",
                      "@workspace/*/schema",
                      "@workspace/kernel/context",
                      "@workspace/kernel/errors",
                      "@workspace/kernel/testing",
                      "@workspace/kernel/trpc"
                    ],
                    "message": "Server-only — apps/web uses module contracts (@workspace/<module>/contract) and reaches the server through tRPC."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@workspace/api": {
                    "allowImportNames": [
                      "AppRouter",
                      "RouterInputs",
                      "RouterOutputs"
                    ],
                    "message": "apps/web may only type-import AppRouter / RouterInputs / RouterOutputs from @workspace/api."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/api/**",
                      "@workspace/*/router",
                      "@workspace/*/schema",
                      "@workspace/kernel/context",
                      "@workspace/kernel/errors",
                      "@workspace/kernel/testing",
                      "@workspace/kernel/trpc"
                    ],
                    "message": "Server-only — apps/web uses module contracts (@workspace/<module>/contract) and reaches the server through tRPC."
                  },
                  {
                    "group": [
                      "@/features/*/components/**",
                      "@/features/*/hooks.ts",
                      "@/features/*/model/**"
                    ],
                    "message": "Reach another feature only through its api.ts (query options) or store.ts (actions)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@workspace/api": {
                    "allowImportNames": [
                      "AppRouter",
                      "RouterInputs",
                      "RouterOutputs"
                    ],
                    "message": "apps/web may only type-import AppRouter / RouterInputs / RouterOutputs from @workspace/api."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/api/**",
                      "@workspace/*/router",
                      "@workspace/*/schema",
                      "@workspace/kernel/context",
                      "@workspace/kernel/errors",
                      "@workspace/kernel/testing",
                      "@workspace/kernel/trpc"
                    ],
                    "message": "Server-only — apps/web uses module contracts (@workspace/<module>/contract) and reaches the server through tRPC."
                  },
                  {
                    "group": ["@/features/*/api.ts", "@/features/*/model/**"],
                    "message": "Routes use a feature's components, hooks.ts and store.ts — not its api.ts or model/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["modules/*/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@workspace/*/router"],
                    "message": "A module never calls another module's router — use its contract or schema."
                  },
                  {
                    "group": ["@workspace/api", "@workspace/api/**"],
                    "message": "Modules sit below the composition in @workspace/api."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["modules/*/src/contract.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@workspace/*/router"],
                    "message": "A module never calls another module's router — use its contract or schema."
                  },
                  {
                    "group": ["@workspace/api", "@workspace/api/**"],
                    "message": "Modules sit below the composition in @workspace/api."
                  },
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "@trpc/server",
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/*/schema",
                      "@workspace/kernel/context",
                      "@workspace/kernel/errors",
                      "@workspace/kernel/testing",
                      "@workspace/kernel/trpc",
                      "./schema.js",
                      "./repo.js",
                      "./router.js"
                    ],
                    "message": "contract.ts ships to the browser — Zod shapes and types only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["modules/*/src/router.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@workspace/*/router"],
                    "message": "A module never calls another module's router — use its contract or schema."
                  },
                  {
                    "group": ["@workspace/api", "@workspace/api/**"],
                    "message": "Modules sit below the composition in @workspace/api."
                  },
                  {
                    "group": ["drizzle-orm", "drizzle-orm/**", "./schema.js"],
                    "message": "Routers reach data only through their module's repo."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Drizzle table columns follow domain order (id → fields → timestamps),
    // not alphabetical — disable useSortedKeys for schema files only.
    {
      "includes": ["modules/*/src/schema.ts"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    }
  ]
}
