{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  // Only negations: core already provides "**" (re-adding it fails noBiomeFirstException).
  "files": {
    "includes": [
      // shadcn (CLI / monorepo shared package)
      "!packages/ui/src/components",
      "!packages/ui/src/lib",
      "!packages/ui/src/hooks",
      "!**/src/components/ui",
      "!**/components/theme-provider.tsx",
      // codegen & generated artifacts
      "!**/src/gen",
      "!**/src/generated",
      "!**/src/__generated__",
      "!**/*.gen.ts",
      "!**/*.gen.tsx",
      "!**/*.generated.ts",
      "!**/*.generated.tsx",
      "!**/routeTree.gen.ts",
      "!**/graphql-env.d.ts",
      "!**/graphql-env.ts",
      "!**/prisma/generated",
      "!**/drizzle/meta"
    ]
  },
  "overrides": [
    // api tests compose real repos via a devDependency on @workspace/db;
    // routers themselves must stay on ctx.repos.
    {
      "includes": ["packages/api/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@workspace/db", "@workspace/db/**"],
                    "message": "packages/api uses ctx.repos only — never import @workspace/db."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Biome replaces (not merges) rule options across overrides, so the
    // feature and route overrides below repeat the web-wide restrictions.
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@workspace/api": {
                    "allowImportNames": [
                      "AppRouter",
                      "RouterInputs",
                      "RouterOutputs"
                    ],
                    "message": "apps/web may only type-import AppRouter / RouterInputs / RouterOutputs from @workspace/api."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/api/**"
                    ],
                    "message": "Server-only package — apps/web reaches the server through tRPC."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@workspace/api": {
                    "allowImportNames": [
                      "AppRouter",
                      "RouterInputs",
                      "RouterOutputs"
                    ],
                    "message": "apps/web may only type-import AppRouter / RouterInputs / RouterOutputs from @workspace/api."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/api/**"
                    ],
                    "message": "Server-only package — apps/web reaches the server through tRPC."
                  },
                  {
                    "group": [
                      "@/features/*/components/**",
                      "@/features/*/hooks.ts",
                      "@/features/*/model/**"
                    ],
                    "message": "Reach another feature only through its api.ts (query options) or store.ts (actions)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@workspace/api": {
                    "allowImportNames": [
                      "AppRouter",
                      "RouterInputs",
                      "RouterOutputs"
                    ],
                    "message": "apps/web may only type-import AppRouter / RouterInputs / RouterOutputs from @workspace/api."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/api/**"
                    ],
                    "message": "Server-only package — apps/web reaches the server through tRPC."
                  },
                  {
                    "group": ["@/features/*/api.ts", "@/features/*/model/**"],
                    "message": "Routes use a feature's components, hooks.ts and store.ts — not its api.ts or model/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Drizzle table columns follow domain order (id → fields → timestamps),
    // not alphabetical — disable useSortedKeys for schema files only.
    {
      "includes": ["packages/db/src/schema/**"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    }
  ]
}
