{
  "name": "ts-fullstack-template",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "e2e": "pnpm build && pnpm --filter web e2e",
    "typecheck": "turbo typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "db:push": "pnpm --filter @workspace/db db:push",
    "db:studio": "pnpm --filter @workspace/db db:studio",
    "db:check": "pnpm --filter @workspace/db db:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "lefthook": "^2.1.10",
    "turbo": "^2.9.18",
    "typescript": "~6",
    "ultracite": "7.9.4",
    "vitest": "^4.1.10"
  }
}
