# Same-origin path in dev; Vite proxies /trpc → apps/server (default :3000).
# For a different host in production, use an absolute URL and set server CORS_ORIGIN.
VITE_TRPC_URL=/trpc

# Dev proxy target. Match apps/server PORT when it is not 3000 (e.g. a second
# git worktree running alongside the first).
# API_PROXY_TARGET=http://localhost:3001
