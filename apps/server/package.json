{
  "name": "server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../packages/db/.env --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../packages/db/.env --env-file-if-exists=.env dist/index.js",
    "test": "vitest run && pnpm test:build",
    "test:build": "pnpm build && node scripts/smoke-build.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/otel": "1.3.0",
    "@hono/trpc-server": "^0.4.2",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@t3-oss/env-core": "^0.13.11",
    "@trpc/server": "^11.22.1",
    "@workspace/api": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/kernel": "workspace:*",
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6"
  }
}
