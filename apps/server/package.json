{
  "name": "server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../packages/db/.env --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../packages/db/.env --env-file-if-exists=.env dist/index.js",
    "test": "vitest run && pnpm test:build",
    "test:build": "pnpm build && node scripts/smoke-build.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@hono/trpc-server": "^0.4.2",
    "@libsql/client": "^0.17.4",
    "@t3-oss/env-core": "^0.13.11",
    "@workspace/api": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/domain": "workspace:*",
    "hono": "^4.12.30",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "~6"
  }
}
