# Copy to .env (gitignored). Platform/CI env vars override file values when already set.
# All keys below are optional for local monorepo defaults.

# Runtime libsql/SQLite URL for createDb (relative to apps/server cwd).
# Default if unset: file:../../packages/db/local.db (same file as packages/db kit).
# Only set this for remote libsql or a non-default local path.
# DB_FILE_NAME=file:../../packages/db/local.db

# HTTP (default 3000)
# PORT=3000

# development | production | test (default development — enables pino-pretty)
# NODE_ENV=development

# pino level: fatal | error | warn | info | debug | trace (default info)
# LOG_LEVEL=info

# Optional: web origin for CORS on /trpc (e.g. http://localhost:5173)
# CORS_ORIGIN=
