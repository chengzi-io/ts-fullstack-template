# Loaded after packages/db/.env:
#   node --env-file-if-exists=../../packages/db/.env --env-file-if-exists=.env …
# Do NOT put DATABASE_* here — own those in packages/db/.env.

# PORT=3000
# NODE_ENV=development
# LOG_LEVEL=info
# CORS_ORIGIN=http://localhost:5173
# HTTP_HEADERS_TIMEOUT_MS=10000
# HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
# HTTP_REQUEST_TIMEOUT_MS=30000
# SHUTDOWN_DRAIN_MS=0          # set to the load balancer's deregistration delay
# SHUTDOWN_TIMEOUT_MS=10000
# Opt-in tracing; unset = off. The exporter reads OTEL_EXPORTER_OTLP_HEADERS,
# the SDK the sampler vars; the span resource takes OTEL_SERVICE_NAME and
# OTEL_RESOURCE_ATTRIBUTES from the environment.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Production rejects a file: DATABASE_URL unless exactly one instance runs:
# DATABASE_SINGLE_INSTANCE=true
