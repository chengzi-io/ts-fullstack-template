{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:check": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs check",
    "db:pull": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs pull"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "1.0.0-rc.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "~6"
  }
}
