# Copy to .env (gitignored). Required for kit + server DB connection.
# Loaded by packages/db kit scripts and apps/server
# (--env-file-if-exists=../../packages/db/.env). Platform/CI env wins if set.
# Do not put PORT / CORS / LOG_* here — those belong to apps/server.
#
# DATABASE_URL is required (no kit default). Without it, drizzle.config throws.
#
# file: paths are relative to process.cwd() (not this .env file).
# From packages/db (kit) and apps/server, ../../local.db is the monorepo root.
# Or absolute file:/… / remote libsql://…
DATABASE_URL=file:../../local.db

# Optional remote Turso / libSQL token. Required for remote; omit for file: URLs.
# Never commit a real value.
# DATABASE_AUTH_TOKEN=
