# Copy to .env (gitignored). Loaded by packages/db kit scripts and by
# apps/server (via --env-file-if-exists=../../packages/db/.env).
# Platform/CI env vars already set win over the file.
# Do not put PORT / CORS / LOG_* here — those belong to apps/server.

# Local libSQL/SQLite (relative to packages/db cwd → packages/db/local.db).
# Or use an absolute file: URL / remote Turso libsql:// URL.
DATABASE_URL=file:local.db

# Optional remote Turso / libSQL token. Required for remote; omit for file: URLs.
# Never commit a real value.
# DATABASE_AUTH_TOKEN=
